# MathMod-Pilot environment variables
# Copy this file to .env and fill in the values you need.
# Only skills that call external APIs require keys.

# OpenRouter API key -- used by the nature-figure skill for AI schematic
# generation (graphical abstracts, mechanism diagrams).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the default nature-figure backend config path.
# NATURE_FIGURE_CONFIG=~/.config/nature-skills/nature-figure.json
