{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://local.codex/schemas/validation_plan.schema.v1.json","title":"Validation Plan v1","type":"object","additionalProperties":false,
  "required":["schema_version","problem_id","model_id","model_artifact_hash","data_artifact_hash","candidate_portfolio_hash","selection_verdict_hash","validation_objective","intended_claims","applicable_checks","non_applicable_checks","metrics","baselines","data_splits","holdouts","backtests","perturbation_ranges","uncertainty_sources","stability_runs","ablation_plan","identifiability_plan","failure_tests","blocking_rules","claim_restriction_rules","created_at","plan_hash"],
  "properties":{
    "schema_version":{"const":"validation_plan.schema.v1"},"problem_id":{"type":"string","minLength":1},"model_id":{"type":"string","minLength":1},
    "model_artifact_hash":{"$ref":"#/$defs/hash"},"data_artifact_hash":{"$ref":"#/$defs/hash"},"candidate_portfolio_hash":{"$ref":"#/$defs/hash"},"selection_verdict_hash":{"$ref":"#/$defs/hash"},
    "validation_objective":{"type":"string","minLength":20},"intended_claims":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["claim_id","target","scope","purpose"],"properties":{"claim_id":{"type":"string","minLength":1},"target":{"type":"string","minLength":3},"scope":{"type":"string","minLength":5},"purpose":{"enum":["PREDICTION","DECISION","PARAMETER_INFERENCE","STATE_RECONSTRUCTION","MECHANISM_INTERPRETATION"]}}}},
    "applicable_checks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/checkId"}},
    "non_applicable_checks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["check_id","reason_code","rationale"],"properties":{"check_id":{"$ref":"#/$defs/checkId"},"reason_code":{"enum":["STRUCTURALLY_NOT_APPLICABLE","NO_EMPIRICAL_GENERALIZATION_CLAIM","NO_DECISION_CHAIN","NO_PARAMETER_OR_STATE_CLAIM","DETERMINISTIC_NO_RANDOMNESS","NO_COMPLEX_COMPONENT"]},"rationale":{"type":"string","minLength":20}}}},
    "metrics":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["metric_id","check_id","name","direction","practical_threshold","uncertainty_method"],"properties":{"metric_id":{"type":"string","minLength":1},"check_id":{"$ref":"#/$defs/checkId"},"name":{"type":"string","minLength":1},"direction":{"enum":["LOWER_BETTER","HIGHER_BETTER","IN_RANGE","BOOLEAN"]},"practical_threshold":{"type":["number","boolean","object"]},"uncertainty_method":{"type":"string","minLength":1}}}},
    "baselines":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["baseline_id","artifact_hash","information_set","split_id","target","loss","constraints","horizon","smallest_effect_of_practical_interest"],"properties":{"baseline_id":{"type":"string","minLength":1},"artifact_hash":{"$ref":"#/$defs/hash"},"information_set":{"type":"string","minLength":1},"split_id":{"type":"string","minLength":1},"target":{"type":"string","minLength":1},"loss":{"type":"string","minLength":1},"constraints":{"type":"array","items":{"type":"string"}},"horizon":{"type":"string","minLength":1},"smallest_effect_of_practical_interest":{"type":"number","exclusiveMinimum":0}}}},
    "data_splits":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["split_id","type","rationale","leakage_boundary"],"properties":{"split_id":{"type":"string","minLength":1},"type":{"enum":["RANDOM","STRATIFIED","GROUP","TEMPORAL_ROLLING","TEMPORAL_BLOCKED","SPATIAL","SCENARIO","EXTERNAL","NONE"]},"rationale":{"type":"string","minLength":10},"leakage_boundary":{"type":"string","minLength":10}}}},
    "holdouts":{"type":"array","items":{"type":"string"}},"backtests":{"type":"array","items":{"type":"string"}},
    "perturbation_ranges":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["parameter","lower","upper","basis"],"properties":{"parameter":{"type":"string","minLength":1},"lower":{"type":"number"},"upper":{"type":"number"},"basis":{"enum":["MEASUREMENT_ACCURACY","DOMAIN_BOUND","HISTORICAL_VARIATION","ESTIMATED_UNCERTAINTY","STRESS_SCENARIO"]}}}},
    "uncertainty_sources":{"type":"array","items":{"type":"string","minLength":1}},"stability_runs":{"type":"array","items":{"type":"string","minLength":1}},"ablation_plan":{"type":"array","items":{"type":"string","minLength":1}},
    "identifiability_plan":{"type":"object","additionalProperties":false,"required":["applicable","purpose","methods","rationale","blocking_if_failed"],"properties":{"applicable":{"type":"boolean"},"purpose":{"enum":["PREDICTION_ONLY","PARAMETER_INFERENCE","STATE_RECONSTRUCTION","MECHANISM_INTERPRETATION","NOT_APPLICABLE"]},"methods":{"type":"array","items":{"enum":["SYMBOLIC","RANK_ANALYSIS","JACOBIAN_RANK","OBSERVABILITY_MATRIX","FISHER_INFORMATION","CONDITION_NUMBER","PROFILE_LIKELIHOOD","MULTISTART_RECOVERY","SIMULATION_RECOVERY","PARAMETER_PERTURBATION","POSTERIOR_CORRELATION","PRACTICAL_IDENTIFIABILITY"]}},"rationale":{"type":"string","minLength":20},"blocking_if_failed":{"type":"boolean"}}},
    "failure_tests":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["test_id","description","risk"],"properties":{"test_id":{"type":"string","minLength":1},"description":{"type":"string","minLength":10},"risk":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]}}}},
    "blocking_rules":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["check_id","condition","failure_class","owner_stage","required_action"],"properties":{"check_id":{"$ref":"#/$defs/checkId"},"condition":{"type":"string","minLength":10},"failure_class":{"enum":["STRUCTURAL","CORRECTABLE"]},"owner_stage":{"enum":["PROBLEM_FORMULATION","DATA_PROCESSING","MODEL_SELECTION","SOLVER","MODEL_VALIDATION"]},"required_action":{"enum":["REVISE_FORMULATION","REVISE_DATA","SIMPLIFY_MODEL","CHANGE_MODEL","REJECT_MODEL","COLLECT_MORE_DATA","RERUN_SOLVER","RERUN_VALIDATION"]}}}},
    "claim_restriction_rules":{"type":"array","items":{"type":"string","minLength":10}},"created_at":{"type":"string","format":"date-time"},"plan_hash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"checkId":{"enum":["V01_MATHEMATICAL_CORRECTNESS","V02_DATA_COMPATIBILITY","V03_BASELINE_SUPERIORITY","V04_OUT_OF_SAMPLE_VALIDITY","V05_SENSITIVITY","V06_ROBUSTNESS","V07_UNCERTAINTY","V08_INTERPRETABILITY_DOMAIN_SENSE","V09_CONSTRAINT_SATISFACTION","V10_FAILURE_ENVELOPE","V11_STABILITY_ABLATION"]}}
}
