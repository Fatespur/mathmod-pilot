  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"checkId":{"enum":["V01_MATHEMATICAL_CORRECTNESS","V02_DATA_COMPATIBILITY","V03_BASELINE_SUPERIORITY","V04_OUT_OF_SAMPLE_VALIDITY","V05_SENSITIVITY","V06_ROBUSTNESS","V07_UNCERTAINTY","V08_INTERPRETABILITY_DOMAIN_SENSE","V09_CONSTRAINT_SATISFACTION","V10_FAILURE_ENVELOPE","V11_STABILITY_ABLATION"]},"record":{"type":"object","additionalProperties":false,"required":["evidence_id","check_id","source_artifact","artifact_sha256","result_pointer","producer_stage","method","input_scope","output_scope","metric","observed_value","reference_or_expected_range","status","notes","created_at"],"properties":{"evidence_id":{"type":"string","minLength":1},"check_id":{"$ref":"#/$defs/checkId"},"source_artifact":{"type":"string","minLength":1},"artifact_sha256":{"$ref":"#/$defs/hash"},"result_pointer":{"type":"string","pattern":"^/"},"producer_stage":{"enum":["S1","S2","SELECTION","S3","S4"]},"method":{"type":"string","minLength":3},"input_scope":{"type":"string","minLength":3},"output_scope":{"type":"string","minLength":3},"metric":{"type":"string","minLength":1},"observed_value":{},"reference_or_expected_range":{},"status":{"enum":["PASS","WARN","FAIL"]},"notes":{"type":"string"},"created_at":{"type":"string","format":"date-time"}}}}
