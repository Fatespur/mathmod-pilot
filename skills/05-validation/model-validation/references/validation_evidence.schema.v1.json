  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://local.codex/schemas/validation_evidence.schema.v1.json","title":"Validation Evidence Bundle v1","type":"object","additionalProperties":false,"required":["schema_version","problem_id","model_id","validation_plan_hash","evidence"],
