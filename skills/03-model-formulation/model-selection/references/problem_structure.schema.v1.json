{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://local.codex/schemas/problem_structure.schema.v1.json",
  "title":"Problem Structure IR v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","problem_id","task_type","purpose","estimand_or_decision","sets","indices","decision_variables","state_variables","observed_variables","parameters","objectives","hard_constraints","soft_constraints","boundary_conditions","initial_conditions","data_dependencies","sample_structure","temporal_structure","spatial_structure","group_structure","network_structure","uncertainty_sources","assumptions","identifiability_risks","expected_ranges","unresolved_ambiguities"],
  "properties":{
    "schema_version":{"const":"problem_structure.schema.v1"},
    "problem_id":{"type":"string","minLength":1},
    "task_type":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["DESCRIPTION","FORECASTING","CLASSIFICATION","REGRESSION","OPTIMIZATION","DECISION","MECHANISM","SIMULATION","CAUSAL","EVALUATION","NETWORK","SPATIAL","MULTI_OBJECTIVE","HYBRID"]}},
    "purpose":{"type":"string","minLength":1},
    "estimand_or_decision":{"type":"string","minLength":1},
    "sets":{"type":"array","items":{"$ref":"#/$defs/symbol"}},
    "indices":{"type":"array","items":{"$ref":"#/$defs/symbol"}},
    "decision_variables":{"type":"array","items":{"$ref":"#/$defs/variable"}},
    "state_variables":{"type":"array","items":{"$ref":"#/$defs/variable"}},
    "observed_variables":{"type":"array","items":{"$ref":"#/$defs/variable"}},
    "parameters":{"type":"array","items":{"$ref":"#/$defs/parameter"}},
    "objectives":{"type":"array","items":{"$ref":"#/$defs/objective"}},
    "hard_constraints":{"type":"array","items":{"$ref":"#/$defs/constraint"}},
    "soft_constraints":{"type":"array","items":{"$ref":"#/$defs/constraint"}},
    "boundary_conditions":{"type":"array","items":{"type":"string"}},
    "initial_conditions":{"type":"array","items":{"type":"string"}},
    "data_dependencies":{"type":"array","items":{"$ref":"#/$defs/dataDependency"}},
    "sample_structure":{"$ref":"#/$defs/sampleStructure"},
    "temporal_structure":{"$ref":"#/$defs/structureBlock"},
    "spatial_structure":{"$ref":"#/$defs/structureBlock"},
    "group_structure":{"$ref":"#/$defs/structureBlock"},
    "network_structure":{"$ref":"#/$defs/networkStructure"},
    "uncertainty_sources":{"type":"array","items":{"$ref":"#/$defs/uncertainty"}},
    "assumptions":{"type":"array","items":{"$ref":"#/$defs/assumption"}},
    "identifiability_risks":{"type":"array","items":{"$ref":"#/$defs/risk"}},
    "expected_ranges":{"type":"array","items":{"$ref":"#/$defs/range"}},
    "unresolved_ambiguities":{"type":"array","items":{"$ref":"#/$defs/risk"}}
  },
  "$defs":{
    "symbol":{"type":"object","additionalProperties":false,"required":["name","meaning"],"properties":{"name":{"type":"string","minLength":1},"meaning":{"type":"string","minLength":1}}},
    "variable":{"type":"object","additionalProperties":false,"required":["name","meaning","domain","unit"],"properties":{"name":{"type":"string","minLength":1},"meaning":{"type":"string","minLength":1},"domain":{"type":"string","minLength":1},"unit":{"type":["string","null"]}}},
    "parameter":{"type":"object","additionalProperties":false,"required":["name","meaning","source","unit","known"],"properties":{"name":{"type":"string","minLength":1},"meaning":{"type":"string","minLength":1},"source":{"type":"string","minLength":1},"unit":{"type":["string","null"]},"known":{"type":"boolean"}}},
    "objective":{"type":"object","additionalProperties":false,"required":["id","sense","quantity","decision_relevance"],"properties":{"id":{"type":"string","minLength":1},"sense":{"enum":["MINIMIZE","MAXIMIZE","ESTIMATE","PREDICT","CLASSIFY","RANK","EXPLAIN","SIMULATE"]},"quantity":{"type":"string","minLength":1},"decision_relevance":{"type":"string","minLength":1}}},
    "constraint":{"type":"object","additionalProperties":false,"required":["id","statement","source"],"properties":{"id":{"type":"string","minLength":1},"statement":{"type":"string","minLength":1},"source":{"type":"string","minLength":1}}},
    "dataDependency":{"type":"object","additionalProperties":false,"required":["name","role","availability","leakage_risk"],"properties":{"name":{"type":"string","minLength":1},"role":{"type":"string","minLength":1},"availability":{"enum":["AVAILABLE","PARTIAL","MISSING","FUTURE_SCENARIO"]},"leakage_risk":{"type":"string"}}},
    "sampleStructure":{"type":"object","additionalProperties":false,"required":["n","p","sampling_unit","dependency","missingness","imbalance"],"properties":{"n":{"type":["integer","null"],"minimum":0},"p":{"type":["integer","null"],"minimum":0},"sampling_unit":{"type":"string"},"dependency":{"type":"string"},"missingness":{"type":"string"},"imbalance":{"type":"string"}}},
    "structureBlock":{"type":"object","additionalProperties":false,"required":["present","features","risks"],"properties":{"present":{"type":"boolean"},"features":{"type":"array","items":{"type":"string"}},"risks":{"type":"array","items":{"type":"string"}}}},
    "networkStructure":{"type":"object","additionalProperties":false,"required":["present","directed","weighted","capacities","demands","vehicles","depots","time_windows","flow_conservation","subtour_risk","multiple_commodities","dynamic_state"],"properties":{"present":{"type":"boolean"},"directed":{"type":["boolean","null"]},"weighted":{"type":["boolean","null"]},"capacities":{"type":"boolean"},"demands":{"type":"boolean"},"vehicles":{"type":"boolean"},"depots":{"type":"boolean"},"time_windows":{"type":"boolean"},"flow_conservation":{"type":"boolean"},"subtour_risk":{"type":"boolean"},"multiple_commodities":{"type":"boolean"},"dynamic_state":{"type":"boolean"}}},
    "uncertainty":{"type":"object","additionalProperties":false,"required":["id","source","kind","decision_impact"],"properties":{"id":{"type":"string"},"source":{"type":"string","minLength":1},"kind":{"enum":["ALEATORY","EPISTEMIC","MEASUREMENT","SCENARIO"]},"decision_impact":{"type":"string"}}},
    "assumption":{"type":"object","additionalProperties":false,"required":["id","statement","type","necessity","risk","falsifier","evidence","downstream_dependency"],"properties":{"id":{"type":"string","minLength":1},"statement":{"type":"string","minLength":1},"type":{"enum":["NECESSARY","SIMPLIFYING","DATA","SOLVABILITY","DOMAIN"]},"necessity":{"type":"string","minLength":1},"risk":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},"falsifier":{"type":"string","minLength":1},"evidence":{"type":"array","items":{"type":"string"}},"downstream_dependency":{"type":"array","items":{"type":"string"}}}},
    "risk":{"type":"object","additionalProperties":false,"required":["id","statement","impact","resolution"],"properties":{"id":{"type":"string"},"statement":{"type":"string","minLength":1},"impact":{"type":"string","minLength":1},"resolution":{"type":"string","minLength":1}}},
    "range":{"type":"object","additionalProperties":false,"required":["quantity","lower","upper","unit","basis"],"properties":{"quantity":{"type":"string"},"lower":{"type":["number","null"]},"upper":{"type":["number","null"]},"unit":{"type":["string","null"]},"basis":{"type":"string","minLength":1}}}
  }
}
