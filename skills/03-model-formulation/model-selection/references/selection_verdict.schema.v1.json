  "title":"Selection Verdict v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","problem_id","selected_candidate","baseline_candidate","serious_alternative","fallback_candidate","anti_template_gate","precondition_summary","why_primary","why_not_baseline","why_not_alternative","replacement_trigger","known_limitations","family_coverage_status","artifact_hashes","blocking_reason","owner_stage","required_action","revision_id"],
  "properties":{
    "schema_version":{"const":"selection_verdict.schema.v1"},"problem_id":{"type":"string","minLength":1},"selected_candidate":{"type":["string","null"]},"baseline_candidate":{"type":["string","null"]},"serious_alternative":{"type":["string","null"]},"fallback_candidate":{"type":["string","null"]},
