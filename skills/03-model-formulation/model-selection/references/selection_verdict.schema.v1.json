    "precondition_summary":{"type":"string","minLength":1},"why_primary":{"type":"string","minLength":10},"why_not_baseline":{"type":"string","minLength":10},"why_not_alternative":{"type":"string","minLength":10},"replacement_trigger":{"type":"string","minLength":10},"known_limitations":{"type":"array","items":{"type":"string"}},"family_coverage_status":{"enum":["SUPPORTED","COVERAGE_LIMITED"]},"artifact_hashes":{"type":"object","required":["problem_structure","candidate_portfolio"],"additionalProperties":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"}},"blocking_reason":{"type":["string","null"]},"owner_stage":{"enum":["PROBLEM_FORMULATION","MODEL_SELECTION","DATA_PROCESSING","SOLVER"]},"required_action":{"enum":["PROCEED_TO_SOLVER","REVISE_FORMULATION","REVISE_SELECTION","COLLECT_MORE_DATA","RETURN_TO_MODEL_SELECTION"]},"revision_id":{"type":"string","minLength":1}
  }
