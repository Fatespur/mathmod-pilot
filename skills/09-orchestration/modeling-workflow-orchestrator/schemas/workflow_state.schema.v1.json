"invalidated_artifacts":{"type":"array"},"revision_history":{"type":"array"},"revision_count":{"type":"integer","minimum":0},
"current_verdict":{"enum":[null,"PASS","PASS_WITH_LIMITATIONS","REVISE","FAIL"]},
"required_action":{"type":["string","null"]},"release_scope":{"type":["string","null"]},
"error_state":{"type":["object","null"]},"resume_stage":{"type":["string","null"]},
"selection_authorized":{"type":"boolean"},"timestamp":{"type":"string"}}}
