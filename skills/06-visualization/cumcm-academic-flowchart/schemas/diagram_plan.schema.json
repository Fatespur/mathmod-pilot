{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagram_plan.schema.json",
  "type": "object",
  "required": ["schema_version", "diagrams"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "diagrams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "diagram_type", "node_count", "candidate_layouts", "target_width_mm", "theme"],
        "properties": {
          "id": {"type": "string"},
          "purpose": {"type": "string"},
          "diagram_type": {"type": "string"},
          "node_count": {"type": "integer", "minimum": 1},
          "candidate_layouts": {"type": "array", "minItems": 4, "items": {"type": "string"}},
          "target_width_mm": {"type": "number"},
          "theme": {"type": "string"}
        }
      }
    }
  }
}
