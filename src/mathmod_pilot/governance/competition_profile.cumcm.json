{
  "profile_name": "cumcm-generic",
  "profile_version": "ph1.1",
  "rules_source": {
    "official_spec_attached": false,
    "note": "No year-specific official CUMCM specification file is attached in this workspace. Rules below encode only workspace-verifiable requirements (final paper PDF + AI usage declaration produced by this pipeline) and conservative defaults. Year-specific filename/page/format rules MUST come from an attached official spec.",
    "verification_status": "WORKSPACE_LOCAL_ONLY"
  },
  "filename_rule": {
    "status": "UNAVAILABLE",
    "action": "MANUAL_CHECK_REQUIRED",
    "note": "CUMCM naming conventions vary by year and are not provable from this workspace; enforced only when an official spec is attached and this block is updated with status=AVAILABLE."
  },
  "page_format_rule": {
    "status": "DELEGATED",
    "consumer": "existing document/format validators (FORMAT_VALIDATION_STATUS consumed verbatim; not re-implemented here)"
  },
  "required_artifact_roles": [
    "final_paper_pdf"
  ],
  "conditionally_required_artifact_roles": [
    {
      "role": "ai_usage_declaration",
      "condition": "paper was produced with LLM assistance (true for this pipeline)",
      "source": "CUMCM AI-usage disclosure practice reflected by S7 deliverable AI使用声明.md"
    }
  ],
  "optional_artifact_roles": [
    "supporting_material_archive",
    "source_code_package",
    "data_appendix",
    "final_paper_docx"
  ],
  "internal_only_path_fragments": [
    "reports/",
    "/logs/",
    "\\logs\\",
    "_mut/",
    "workflow_state",
    "__pycache__",
    "rendered_pages",
    "contact_sheet",
    "final_audit",
    "review_report",
    "publication_staleness",
    "figure_provenance_report",
    "paper_number_report",
    "claim_gate_result",
    "reference_validation",
    "evidence_index",
    "section_evidence_map",
    "debug",
    "fault_injection",
    "baseline_core_hashes",
    "anonymity_verdict",
    "package_compliance_result",
    "submission_authorization"
  ],
  "do_not_submit_filename_rules": [
    {"match": "~$*", "reason": "office lock/temp file"},
    {"match": "*.tmp", "reason": "temporary file"},
    {"match": "*.bak", "reason": "backup copy"},
    {"match": "*.old", "reason": "backup copy"},
    {"match": "*~", "reason": "editor backup"},
    {"match": "*.swp", "reason": "editor swap file"},
    {"match": "*autosave*", "reason": "autosave artifact"},
    {"match": "*.lock", "reason": "lock file"},
    {"match": ".~lock.*", "reason": "office lock file"},
    {"match": "*(*).*", "reason": "duplicate-copy '(1)' style name", "regex": "\\([^)]*\\d[^)]*\\)\\.[^.]+$"},
    {"match": "id_rsa*", "reason": "private credential"},
    {"match": "*.pem", "reason": "private credential"},
    {"match": "*.key", "reason": "private credential"},
    {"match": "*password*", "reason": "credential-named file"},
    {"match": "*secret*", "reason": "credential-named file"}
  ],
  "anonymity_policy": {
    "docx_comments_present": "FAIL",
    "docx_tracked_changes_present": "FAIL",
    "docx_hidden_text_present": "FAIL",
    "docx_external_image_relationship": "FAIL",
    "docx_local_file_relationship": "FAIL",
    "docx_custom_xml_parts": "MANUAL_REVIEW",
    "docx_custom_properties": "SCAN_THEN_CLASSIFY",
    "docx_embedded_objects": "MANUAL_REVIEW",
    "metadata_identity_match": "FAIL",
    "metadata_nonempty_unmatched_creator_fields": "MANUAL_REVIEW",
    "body_high_confidence_identity": "FAIL",
    "body_low_confidence_identity": "MANUAL_REVIEW",
    "local_path_with_user_segment": "FAIL",
    "local_path_generic": "PRIVACY_WARN",
    "pdf_metadata_identity_match": "FAIL",
    "validator_mode": "READ_ONLY_DETECT_AND_BLOCK",
    "auto_sanitization": "FORBIDDEN_IN_PH1"
  },
  "metadata_neutral_allowlist": ["", "author", "anonymous", "-"],
  "severity_order": {"fail": 3, "manual": 2, "warn": 1}
}
